{
  "name": "git-md-pwa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "make:icons": "node scripts/make-icons.mjs",
    "verify:pwa": "npm run build && node scripts/verify-pwa.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "mermaid": "~10.9.8",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
